<Window x:Class="Menu_principal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Menu_principal"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Archivo" Click="MenuItem_Click">
                    <MenuItem Header="Nuevo"/>
                    <MenuItem Header="Abrir"/>
                    <MenuItem Header="Guardar"/>
                    <Separator/>
                    <MenuItem Header="_Salir" Click="MenuItem_Click"/>
                </MenuItem>

                <MenuItem Header="_Herramientas">
                    <MenuItem Header="Administrar Usuarios">
                        <MenuItem.Icon>
                            <Image Source="C:\PAI\MenuContextuall\Imagenes\logro-del-objetivo.png" 
                                   Width="16" 
                                   Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header=" Mostrar Grupos" IsCheckable="True" IsChecked="True"/>
                </MenuItem>
            </Menu>
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button Content="Nuevo" ToolTip="Nuevo"/>
                    <Button Content="Abrir" ToolTip="Abrir"/>
                    <Button Content="Guardar" ToolTip="Guardar"/>
                </ToolBar>
                <ToolBar>
                    <Button Content="Muevo"/>
                    <Button Content="Abrir"/>
                    <Button Content="Guardar"/>
                </ToolBar>
            </ToolBarTray>
            <TextBox TextWrapping="Wrap" Text="Text box" TextChanged="TextBox_TextChanged" Width="100"/>
        </DockPanel>
    </Grid>
</Window>
