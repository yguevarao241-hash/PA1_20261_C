<Window x:Class="MenuContextual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MenuContextual"
        mc:Ignorable="d"
        Title="Menu Contextual"
        Height="450"
        Width="800">
    <Grid>

        <DockPanel>

            <!-- Menú Principal -->
            <Menu DockPanel.Dock="Top">

                <MenuItem Header="_Archivo">

                    <MenuItem Header="_Nuevo"/>

                    <MenuItem Header="_Abrir"/>

                    <MenuItem Header="_Guardar"/>

                    <Separator/>

                    <MenuItem Header="_Salir"
                              Click="MenuItem_Click"/>

                </MenuItem>

                <MenuItem Header="_Herramientas">

                    <MenuItem Header="Administrar Usuarios">
                        <MenuItem.Icon>
                            <Image Source="Imagenes/usuario.png"
                                   Width="16"
                                   Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Mostrar Grupos"
                              IsCheckable="True"
                              IsChecked="True"/>

                </MenuItem>

                <MenuItem Header="_Ayuda">

                    <MenuItem Header="Acerca de"/>

                </MenuItem>

            </Menu>

            <!-- Barra de herramientas -->
            <ToolBarTray DockPanel.Dock="Top">

                <ToolBar>

                    <Button Content="Nuevo"/>

                    <Button Content="Abrir"/>

                    <Button Content="Guardar"/>

                </ToolBar>

                <ToolBar>

                    <Button Content="Usuarios"/>

                    <Button Content="Grupos"/>

                    <Button Content="Salir"
                            Click="MenuItem_Click"/>

                </ToolBar>

            </ToolBarTray>

            <!-- Contenido -->
            <TextBox Width="250"
                     Height="30"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="Programación Aplicada I"/>

        </DockPanel>

    </Grid>

</Window>