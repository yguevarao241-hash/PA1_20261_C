<Window x:Class="SQLserverEjemplos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQLserverEjemplos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnVerificacionConexion" Content="Boton Conectar a SQL" HorizontalAlignment="Left" Margin="237,106,0,0" VerticalAlignment="Top" Click="btnVerificacionConexion_Click"/>
        <Button x:Name="btnCargarCategorias" Content="CargarCategorias" HorizontalAlignment="Left" Margin="450,106,0,0" VerticalAlignment="Top" Click="btnCargarCategorias_Click"/>
        <ComboBox x:Name="cbxCategorias" HorizontalAlignment="Left" Margin="237,171,0,0" VerticalAlignment="Top" Width="120" DisplayMemberPath="Nombre"/>
        <Button x:Name="btnMostrarSelecionado" Content="Mostrar Selecionado" HorizontalAlignment="Left" Margin="450,173,0,0" VerticalAlignment="Top" Click="btnMostrarSelecionado_Click"/>
    </Grid>
</Window>
