<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid HorizontalAlignment="Center" Height="117" Margin="0,10,0,0" VerticalAlignment="Top" Width="780">
            <StackPanel Margin="203,0,145,0">
                <Label Content="OPERACIONES MATEMATICAS" FontWeight="Bold" FontSize="16" FontFamily="Showcard Gothic" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="97" Margin="81,98,0,0" VerticalAlignment="Top" Width="377">
            <Label Content="Numero 1:" HorizontalAlignment="Left" Margin="10,25,0,0" VerticalAlignment="Top" Width="91" FontWeight="Bold"/>
            <Label Content="Numero 2:" HorizontalAlignment="Left" Margin="10,56,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="txtNumero1" HorizontalAlignment="Left" Margin="106,29,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="txtNumero2" HorizontalAlignment="Left" Margin="106,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="68" Margin="483,127,0,0" VerticalAlignment="Top" Width="286">
            <Button x:Name="btSuma" Content="+" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="22" Height="34" Width="34" Click="btSuma_Click"/>
            <Button x:Name="btDivision" Content="/" HorizontalAlignment="Left" Margin="143,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="22" Width="34" Click="btDivision_Click"/>
            <Button x:Name="btMultilplicacion" Content="x" HorizontalAlignment="Left" Margin="212,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.763,-0.382" FontSize="22" FontWeight="Bold" Width="37"/>
            <Button x:Name="btResta" Content="-" HorizontalAlignment="Left" Margin="80,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="22" Width="36" Click="btResta_Click"/>
        </Grid>
        <Grid HorizontalAlignment="Left" Height="75" Margin="104,281,0,0" VerticalAlignment="Top" Width="571" Background="#FF4750E2">
            <Label Content="Resultado" HorizontalAlignment="Left" Margin="25,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtResultado" HorizontalAlignment="Left" Margin="98,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="120"/>
        </Grid>
    </Grid>
</Window>
