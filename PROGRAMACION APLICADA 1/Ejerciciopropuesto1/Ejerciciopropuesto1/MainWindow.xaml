<Window x:Class="Ejercicio_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Rectangle HorizontalAlignment="Center" Height="46" Stroke="Black" VerticalAlignment="Top" Width="800" Fill="#FFE78EF7"/>
        <Label Content="INFORMACIÓN GENERAL" HorizontalAlignment="Left" Margin="30,10,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="25"/>

        <Label Content="Personal:" HorizontalAlignment="Left" Margin="30,51,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.539,1.562" FontSize="20" FontFamily="Artifakt Element Heavy"/>
        <TextBox x:Name="txtPersonal" HorizontalAlignment="Left" Margin="138,56,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="192" Height="28"/>

        <Label Content="Código:" HorizontalAlignment="Left" Margin="360,51,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.539,1.562" FontSize="20" FontFamily="Artifakt Element Heavy"/>
        <TextBox x:Name="txtCodigo" HorizontalAlignment="Left" Margin="450,56,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="192" Height="28"/>

        <Label Content="Aportaciones" HorizontalAlignment="Left" Margin="30,97,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="chkFonavi" Content="Fonavi(8%)" HorizontalAlignment="Left" Margin="30,123,0,0" VerticalAlignment="Top" Height="19" Width="115"/>
        <CheckBox x:Name="chkImpRenta" Content="Imp. Renta(5%) " HorizontalAlignment="Left" Margin="30,142,0,0" VerticalAlignment="Top" Height="19" Width="115"/>
        <CheckBox x:Name="chkAFP" Content="A.F.P(12%) " HorizontalAlignment="Left" Margin="30,161,0,0" VerticalAlignment="Top" Height="19" Width="115"/>

        <Label Content="Ingreso:" HorizontalAlignment="Left" Margin="51,196,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.539,1.562" FontSize="15" FontFamily="Artifakt Element Heavy"/>
        <TextBox x:Name="txtIngreso" HorizontalAlignment="Left" Margin="138,196,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="192" Height="28"/>

        <Button x:Name="btnCalcular" Content="Calcular" HorizontalAlignment="Left" Margin="457,200,0,0" VerticalAlignment="Top" Width="89" Click="btnCalcular_Click" Background="#FFE78EF7"/>

        <Rectangle HorizontalAlignment="Center" Height="46" Stroke="Black" VerticalAlignment="Top" Width="800" Fill="#FFE78EF7" Margin="0,241,0,0"/>
        <Label Content="RESULTADOS" HorizontalAlignment="Left" Margin="30,248,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="23"/>

        <Label Content="fonavi:" HorizontalAlignment="Left" Margin="30,292,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtResultadoFonavi" HorizontalAlignment="Left" Margin="88,297,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="339"/>

        <Label Content="Imp. Renta:" HorizontalAlignment="Left" Margin="30,318,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtResultadoRenta" HorizontalAlignment="Left" Margin="106,323,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="339"/>

        <Label Content="A.F.P:" HorizontalAlignment="Left" Margin="30,344,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtResultadoAFP" HorizontalAlignment="Left" Margin="106,354,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="339"/>

        <Label Content="Total a pagar:" HorizontalAlignment="Left" Margin="382,375,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtResultadoTotal" HorizontalAlignment="Left" Margin="468,380,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="339"/>
    </Grid>
</Window>