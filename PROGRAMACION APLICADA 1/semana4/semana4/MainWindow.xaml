<Window x:Class="semana4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:semana4"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="141*" />
            <RowDefinition Height="293*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <ComboBox x:Name="cmbFrutas" Width="139">
                <ComboBoxItem Content="Pera" />
                <ComboBoxItem Content="Piña" />
                <ComboBoxItem Content="Papaya" />
                <ComboBoxItem Content="Limon" />
            </ComboBox>

            <Button x:Name="btnMostrar"
                    Content="Mostrar Seleccionado"
                    Width="139" Click="btnMostrar_Click" />
        </StackPanel>
        <TextBox x:Name="txtnuevo" HorizontalAlignment="Center" Margin="0,57,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Nuevo" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="idagregar" Content="Agregar" HorizontalAlignment="Center" Margin="0,103,0,0" Grid.Row="1" VerticalAlignment="Top" Click="idagregar_Click"/>
        <Label Content="Nueva Fruta" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="1" VerticalAlignment="Top"/>

    </Grid>
</Window>
