<Window x:Class="EjerciciosS3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjerciciosS3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="273*"/>
            <ColumnDefinition Width="527*"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="cbTipoLetra" Content="Cambiar tipo de letra" HorizontalAlignment="Left" Margin="90,82,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbColorTexto" Content="cambiar color de texto" HorizontalAlignment="Left" Margin="90,102,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbColorFondo" Content="Cambia color de fondo" HorizontalAlignment="Left" Margin="90,122,0,0" VerticalAlignment="Top"/>
        <GroupBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="97" Header="" Margin="47,68,0,0" VerticalAlignment="Top" Width="706">
            <Button x:Name="btAplicar" Content="Aplicar" HorizontalAlignment="Left" Margin="353,0,0,0" VerticalAlignment="Top" Click="btAplicar_Click"/>
        </GroupBox>
        <TextBox HorizontalAlignment="Left" Margin="68,33,0,0" TextWrapping="Wrap" Text="ControlCheckboxs" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="lbtexto" Content="Usac el control checkboks" HorizontalAlignment="Left" Margin="122,110,0,0" VerticalAlignment="Top" Grid.Column="1" Background="#FFE6D2D2"/>
        <TextBox HorizontalAlignment="Left" Margin="68,187,0,0" TextWrapping="Wrap" Text="Control Radio Buton" VerticalAlignment="Top" Width="120"/>
        <GroupBox Header="" Margin="68,217,65,42" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="rbTipoLetra" Content="Cambiar tipo de letra" HorizontalAlignment="Left" Margin="118,253,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="rbColorTexto" Content="Cambiar color de texto" HorizontalAlignment="Left" Margin="117,273,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="rbColorFondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="117,289,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAplicarRadio" Grid.Column="1" Content="Aplicar" HorizontalAlignment="Left" Margin="99,253,0,0" VerticalAlignment="Top" Click="btnAplicarRadio_Click"/>
        <Label x:Name="lbTextoRadio" Grid.Column="1" Content="Usa el control de RadioButon" HorizontalAlignment="Left" Margin="103,284,0,0" VerticalAlignment="Top" Background="#FFE5B1B1"/>

    </Grid>
</Window>
